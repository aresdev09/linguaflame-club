# Скопируйте этот файл в .env и заполните значениями.
# .env не попадает в git — реальные ключи и токены храните только там.

# Токен Telegram-бота (получить у @BotFather). Обязательная переменная.
BOT_TOKEN=

# Имя бота без @, например LinguaFlameClubBot (для ссылки «Add to group»).
BOT_USERNAME=

# Подключение к базе данных.
# Продакшен (PostgreSQL): postgresql+asyncpg://user:password@localhost:5432/linguaflame_club
# Разработка (SQLite):    sqlite+aiosqlite:///./linguaflame-club.db
DATABASE_URL=sqlite+aiosqlite:///./linguaflame-club.db

# Redis: блокировки игр, кеш, лимиты.
REDIS_URL=redis://localhost:6379/0

# ИИ: любой OpenAI-совместимый API. Пример для OpenRouter.
AI_SERVER_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
# Таймаут одного запроса к ИИ, секунды.
AI_TIMEOUT_SECONDS=30
# Дневная квота запросов к ИИ на один чат (0 — без ограничения).
AI_QUOTA_PER_DAY=30

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Лимиты Telegram и антиспам ---
# Сообщений на один чат в минуту (лимит Telegram — около 20).
LIMIT_MESSAGES_PER_MINUTE=20
# Пауза между командами, секунды.
LIMIT_COMMAND_COOLDOWN_SECONDS=3
# Пауза для тяжёлых команд (квиз, /word), секунды.
LIMIT_HEAVY_COMMAND_COOLDOWN_SECONDS=10
# Пауза между играми в одном чате, секунды.
LIMIT_GAME_COOLDOWN_SECONDS=10
# Игр в день на один чат.
LIMIT_GAMES_PER_DAY=30

# --- Очки (значения по умолчанию, можно менять без правки кода) ---
SCORE_QUIZ_CORRECT=10
SCORE_QUIZ_SPEED_BONUS_MAX=5
SCORE_QUIZ_FIRST_BONUS=2
SCORE_SCRAMBLE_CORRECT=5
SCORE_GAP_CORRECT=8
SCORE_RACE_WORD_MAX=6
SCORE_TRUEFALSE_CORRECT=5
SCORE_PARTICIPATION=2
SCORE_DAILY_BONUS=3
SCORE_STREAK_BONUS=2
SCORE_DAILY_CAP=300
