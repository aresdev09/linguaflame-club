# Скопируйте этот файл в .env и заполните значениями.
# .env не попадает в git — реальные ключи и токены храните только там.

# Токен Telegram-бота (получить у @BotFather). Обязательная переменная.
BOT_TOKEN=

# Имя бота без @, например LinguaFlameClubBot (для ссылки «Add to group»).
BOT_USERNAME=

# Подключение к базе данных.
# Продакшен (PostgreSQL): postgresql+asyncpg://user:password@localhost:5432/linguaflame_club
# Разработка (SQLite):    sqlite+aiosqlite:///./linguaflame-club.db
DATABASE_URL=sqlite+aiosqlite:///./linguaflame-club.db

# Пароль PostgreSQL в docker-compose (пользователь и база заданы в compose).
POSTGRES_PASSWORD=linguaflame

# Redis: блокировки игр, кеш, лимиты.
REDIS_URL=redis://localhost:6379/0

# ИИ: любой OpenAI-совместимый API.
# По умолчанию NVIDIA NIM: ключ nvapi-... с https://build.nvidia.com
AI_SERVER_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Резервная модель, если основная не отвечает. Пусто — работать без резерва.
AI_MODEL_FALLBACK=deepseek-ai/deepseek-v4.1-flash
# Пример для OpenRouter: AI_SERVER_URL=https://openrouter.ai/api/v1
# Таймаут одного запроса к ИИ, секунды. Холодный старт модели бывает долгим.
AI_TIMEOUT_SECONDS=90
# Дневная квота запросов к ИИ на один чат (0 — без ограничения).
AI_QUOTA_PER_DAY=30
# Глобальный дневной бюджет запросов к ИИ по всем чатам (0 — без ограничения).
AI_GLOBAL_DAILY_LIMIT=300

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Структурные логи одной JSON-строкой на событие (удобно на сервере).
# false — читаемый текст для разработки.
LOG_JSON=false

# --- Лимиты Telegram и антиспам ---
# Сообщений на один чат в минуту (лимит Telegram — около 20).
LIMIT_MESSAGES_PER_MINUTE=20
# Глобальный лимит отправок бота в секунду (Telegram — около 30).
LIMIT_GLOBAL_PER_SECOND=20
# Пауза между командами, секунды.
LIMIT_COMMAND_COOLDOWN_SECONDS=3
# Пауза для тяжёлых команд (квиз, /word), секунды.
LIMIT_HEAVY_COMMAND_COOLDOWN_SECONDS=10
# Пауза между играми в одном чате, секунды.
LIMIT_GAME_COOLDOWN_SECONDS=10
# Игр в день на один чат.
LIMIT_GAMES_PER_DAY=30
# Время на раунд игр, секунды.
QUIZ_ROUND_SECONDS=20
SCRAMBLE_ROUND_SECONDS=30
GAP_ROUND_SECONDS=20
RACE_ROUND_SECONDS=12
TRUEFALSE_ROUND_SECONDS=20
# Пауза между раундами, секунды.
QUIZ_BREAK_SECONDS=3

# --- Очки (значения по умолчанию, можно менять без правки кода) ---
SCORE_QUIZ_CORRECT=10
SCORE_QUIZ_SPEED_BONUS_MAX=5
SCORE_QUIZ_FIRST_BONUS=2
SCORE_SCRAMBLE_CORRECT=5
SCORE_GAP_CORRECT=8
SCORE_RACE_WORD_MAX=6
SCORE_TRUEFALSE_CORRECT=5
SCORE_PARTICIPATION=2
SCORE_DAILY_BONUS=3
SCORE_STREAK_BONUS=2
SCORE_DAILY_CAP=300

# --- Планировщик: ежедневные посты, огонёк, итоги недели ---
# Как часто планировщик проверяет чаты, секунды.
SCHEDULER_TICK_SECONDS=60
# Сдвиг «сейчас» планировщика для ручной проверки: 2h, 1d3h30m, -45m, 90 (минуты).
# 0 — без сдвига. Часовые пояса и настройки групп не меняются.
SCHEDULER_TIME_OFFSET=0
# Вечернее напоминание об огоньке и утреннее сообщение о потерянном огоньке
# (по времени группы, формат HH:MM).
SCHEDULER_REMINDER_TIME=20:00
SCHEDULER_STREAK_LOST_TIME=09:00
# Разброс автосообщений, секунды: группы не получают их одной секундой.
SCHEDULER_JITTER_MAX_SECONDS=120
# Не больше стольких автосообщений в сутки на чат: пост дня, веха огонька,
# напоминание и итоги недели вместе.
SCHEDULER_MESSAGES_PER_DAY=2
# Через сколько дней без очков автосообщения прекращаются.
SCHEDULER_DORMANT_DAYS=7
# Попытки собрать контент поста дня и пауза между ними, секунды.
SCHEDULER_CONTENT_ATTEMPTS=3
SCHEDULER_RETRY_DELAY_SECONDS=600

# --- Админ-инструменты, защита и приватность (этап 10) ---
# Ответы быстрее этого времени (мс) не получают бонус скорости: похоже на бота.
SCORE_FAST_ANSWER_MS=500
# Сколько часов после /reset_scores рейтинг можно вернуть откатом.
SCORE_RESET_UNDO_HOURS=24
# Тексты ответов игр хранятся столько дней, затем очищаются (статистика остаётся).
MAINTENANCE_ANSWER_RETENTION_DAYS=7
# Данные группы удаляются через столько дней после удаления бота из неё.
MAINTENANCE_CHAT_RETENTION_DAYS=30
# Как часто планировщик запускает уборку данных, часы.
MAINTENANCE_TICK_HOURS=24
